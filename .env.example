# Copy to .env or set in your hosting dashboard.

# Port to run on (hosting providers usually set this for you)
PORT=3000

# --- Email / OTP (required for real verification emails) ---
# Uses Gmail SMTP by default. You must use an App Password, not your normal
# password: https://myaccount.google.com/apppasswords (enable 2FA first).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=grimreaper6969699@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=grimreaper6969699@gmail.com

# If SMTP is left unconfigured, the server runs in dev mode and prints
# verification codes to the console so you can test locally.

# --- Optional API keys ---
# Free key from https://haveibeenpwned.com/API/Key - enables email breach checks
HIBP_API_KEY=

# Free key from https://numverify.com - enables phone carrier/validity checks
NUMVERIFY_API_KEY=

# --- Rate limiting: max requests per IP per window ---
RATE_LIMIT=60
RATE_WINDOW_MS=600000

# --- Sessions ---
# Should be set to true in production (HTTPS). Usually set automatically when NODE_ENV=production.
COOKIE_SECURE=
